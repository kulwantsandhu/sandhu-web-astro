---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank you">	
    <div class="thanks">
		<h1>Thanks for your message!</h1>
		<p>I've received your details and will get back to you within 24 hours.</p>
		<a href="/" class="back-home">← Back to home</a>
	</div>
</Layout>

<style>
	.thanks {
		padding: 60px 0;
		text-align: center;
	}
	.back-home {
		display: inline-block;
		margin-top: 20px;
		background: var(--color-accent);
		color: #fff;
		padding: 12px 24px;
		border-radius: 24px;
		font-weight: 600;
	}
</style>