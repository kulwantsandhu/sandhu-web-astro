---
import Layout from '../../layouts/Layout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const caseStudies = await getCollection('caseStudies');

// Get each industry once, e.g. ["Marketing", "SaaS", "Healthcare"]
const industries = [...new Set(caseStudies.map((item) => item.data.industry))];
---

<Layout>
	<h1>Case Studies</h1>
	<p>Some of the projects we've worked on.</p>

	<div class="filters">
		<button class="filter active" data-filter="all">All</button>
		{industries.map((industry) => (
			<button class="filter" data-filter={industry}>{industry}</button>
		))}
	</div>

	<div class="grid">
		{caseStudies.map((item) => (
			<div class="grid-item" data-industry={item.data.industry}>
				<CaseStudyCard
					title={item.data.title}
					summary={item.data.summary}
					industry={item.data.industry}
					client={item.data.client}
					featured={item.data.featured}
					href={`/case-studies/${item.id}`}
					image={item.data.cover}
					imageAlt={item.data.coverAlt}
				/>
			</div>
		))}
	</div>
</Layout>

<script>
	const buttons = document.querySelectorAll('.filter');
	const items = document.querySelectorAll('.grid-item');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter;

			buttons.forEach((b) => b.classList.remove('active'));
			button.classList.add('active');

			items.forEach((item) => {
				const show = filter === 'all' || item.dataset.industry === filter;
				item.style.display = show ? '' : 'none';
			});
		});
	});
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 30px;
	}
	.filter {
		border: 1px solid var(--color-border);
		background: #fff;
		padding: 8px 18px;
		border-radius: 20px;
		font: inherit;
		font-size: 14px;
		cursor: pointer;
	}
	.filter:hover {
		border-color: var(--color-accent);
	}
	.filter.active {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 24px;
		margin-top: 30px;
	}
</style>