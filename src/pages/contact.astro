---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<h1>Let's talk</h1>
	<p>Tell me about your project and I'll reply within 24 hours.</p>

	<form
		name="contact"
		method="POST"
		action="/thanks"
		data-netlify="true"
		netlify-honeypot="bot-field"
		class="contact-form"
	>
		<input type="hidden" name="form-name" value="contact" />

		<p class="hidden">
			<label>Don't fill this out: <input name="bot-field" /></label>
		</p>

		<label>
			Name
			<input type="text" name="name" required />
		</label>

		<label>
			Email
			<input type="email" name="email" required />
		</label>

		<label>
			Project details
			<textarea name="message" rows="6" required></textarea>
		</label>

		<button type="submit">Send message</button>
	</form>
</Layout>

<style>
	.contact-form {
		display: grid;
		gap: 20px;
		max-width: 560px;
		margin-top: 40px;
	}
	label {
		display: grid;
		gap: 8px;
		font-weight: 600;
		font-size: 14px;
	}
	input,
	textarea {
		font: inherit;
		font-weight: 400;
		padding: 12px 14px;
		border: 1px solid var(--color-border);
		border-radius: 10px;
	}
	input:focus,
	textarea:focus {
		outline: 2px solid var(--color-accent);
		border-color: transparent;
	}
	button {
		justify-self: start;
		background: var(--color-accent);
		color: #fff;
		border: none;
		padding: 12px 24px;
		border-radius: 24px;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.hidden {
		display: none;
	}
</style>