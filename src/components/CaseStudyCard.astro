---
import { Image } from 'astro:assets';

const { title, summary, industry, client, featured = false, href, image, imageAlt } = Astro.props;
---

<a href={href} class="card">
	<div class="thumb">
		<Image src={image} alt={imageAlt} width={640} />
	</div>

	<div class="card-body">
		{featured && <span class="badge">Featured</span>}
		<p class="industry">{industry}</p>
		<h2>{title}</h2>
		<p>{summary}</p>
		<p class="client">Client: {client}</p>
	</div>
</a>

<style>
	.card {
		border: 1px solid var(--color-border);
		border-radius: 12px;
		overflow: hidden;
		display: block;
	}
	.card:hover {
		border-color: var(--color-accent);
	}
	.thumb {
		aspect-ratio: 3 / 2;
		background: var(--color-border);
	}
	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.card-body {
		padding: 24px;
	}
	.card h2 {
		font-size: 22px;
		margin: 0 0 8px;
	}
	.industry {
		font-size: 13px;
		text-transform: uppercase;
		color: var(--color-accent);
		margin-bottom: 8px;
	}
	.client {
		font-size: 14px;
		margin: 0;
	}
	.badge {
		display: inline-block;
		background: var(--color-accent);
		color: #fff;
		font-size: 12px;
		padding: 4px 10px;
		border-radius: 20px;
		margin-bottom: 12px;
	}
</style>